{
  "name": "dsh-github-connector",
  "description": "GitHub connectivity for the DeepSeek Harness (dsh): capability seam, REST provider, model-facing tools, Device Flow connect, and PR workflow UI",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "build": "tsc -b tsconfig.json && node scripts/build-entry-shims.ts && node scripts/build-client-bundle.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "gen:catalog": "pnpm build && node scripts/gen-tool-catalog.ts",
    "gate:catalog": "pnpm build && node scripts/gen-tool-catalog.ts --check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dsh-github": "workspace:*",
    "dsh-tool-github": "workspace:*",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
